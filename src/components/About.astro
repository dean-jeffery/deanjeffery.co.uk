---
// src/components/About.astro
import { MapPin, Mail, Phone } from 'lucide-react';
---

<section id='about' class='py-20 bg-white'>
	<div class='max-w-6xl mx-auto px-4 sm:px-6 lg:px-8'>
		<h2 class='text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900'>About Me</h2>
		<div class='max-w-4xl mx-auto'>
			<div class='bg-gray-50 rounded-lg p-8'>
				<p class='text-lg text-gray-700 mb-6'>Hello!! I'm Dean</p>
				A front end focused web developer from Newcastle Upon Tyne and now based in South Tyneside.
			</div>
		</div>

		<!-- Contact Info -->
		<div class='mt-8 flex flex-wrap gap-6 justify-center text-gray-600'>
			<div class='flex items-center gap-2'>
				<MapPin size={18} />
				<span>Newcastle Upon Tyne, UK</span>
			</div>
			<div class='flex items-center gap-2'>
				<Mail size={18} />
				<span>itsdeanrj@gmail.com</span>
			</div>
			<div class='flex items-center gap-2'>
				<Phone size={18} />
				<span>07984377720</span>
			</div>
		</div>
	</div>
</section>
