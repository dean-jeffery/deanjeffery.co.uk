---
const services = [
	{
		icon: 'code',
		title: 'Frontend development',
		description: 'Responsive, accessible interfaces built from design handoff through to production.',
	},
	{
		icon: 'shopping_cart',
		title: 'E-commerce & CMS',
		description: 'Shopify, WordPress and content-managed pages with reusable components and sections.',
	},
	{
		icon: 'speed',
		title: 'Performance & accessibility',
		description: 'Semantic HTML, sensible CSS, Lighthouse checks, responsive testing and usability improvements.',
	},
] as const;
---

<section class='space-y-12'>
	<h2 class='flex items-center gap-4 text-2xl font-semibold text-slate-900'>
		<span class='block h-px w-8 bg-blue-600'></span> What I do
	</h2>
	<div class='grid grid-cols-1 gap-6 md:grid-cols-3'>
		{
			services.map((service) => (
				<div class='group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:border-blue-600 hover:shadow-md'>
					<div class='mb-8 flex h-14 w-14 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 transition-colors group-hover:border-blue-600 group-hover:bg-blue-50'>
						<span class='material-symbols-outlined text-blue-600'>{service.icon}</span>
					</div>
					<h3 class='mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-slate-900'>{service.title}</h3>
					<p class='mt-auto text-slate-600'>{service.description}</p>
				</div>
			))
		}
	</div>
</section>
