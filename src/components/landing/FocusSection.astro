---
const focusItems = [
	{
		number: '01',
		title: 'Rebuilding this site',
		description: 'Turning a simple CV page into a faster, more complete personal site.',
	},
	{
		number: '02',
		title: 'Sharpening JavaScript',
		description: 'Improving core JS, TypeScript and React through practical projects.',
	},
	{
		number: '03',
		title: 'Building side projects',
		description: 'Working towards a small set of portfolio-ready projects with proper write-ups.',
	},
] as const;
---

<section id='focus' class='space-y-12'>
	<h2 class='flex items-center gap-4 text-2xl font-semibold text-slate-900'>
		<span class='block h-px w-8 bg-blue-600'></span> Currently focused on
	</h2>
	<div class='grid grid-cols-1 gap-4'>
		{
			focusItems.map((item) => (
				<div class='group grid grid-cols-1 items-start gap-6 overflow-hidden rounded-xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:border-blue-600 hover:shadow-md md:grid-cols-12'>
					<div class='text-sm font-semibold uppercase tracking-[0.25em] text-slate-400 transition-colors group-hover:text-blue-600 md:col-span-1'>
						{item.number}
					</div>
					<div class='space-y-3 md:col-span-11'>
						<h3 class='text-xl font-semibold text-slate-900 transition-colors group-hover:text-blue-600'>{item.title}</h3>
						<p class='text-slate-600'>{item.description}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
