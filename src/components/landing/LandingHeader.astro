---
const links = [
	{ label: 'CV', href: '/cv' },
	{ label: 'Now', href: '#focus' },
	{ label: 'Contact', href: '#contact' },
] as const;
---

<header class='sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md'>
	<div class='mx-auto flex h-20 max-w-6xl items-center justify-between px-5 sm:px-6 lg:px-8'>
		<a class='flex items-center gap-2 font-semibold text-slate-900' href='/'>
			<span class='h-2.5 w-2.5 rounded-full bg-blue-600'></span>
			Dean Jeffery
		</a>
		<nav class='hidden gap-8 text-sm font-medium text-slate-600 md:flex'>
			{
				links.map((link) => (
					<a class='transition-colors hover:text-blue-600' href={link.href}>
						{link.label}
					</a>
				))
			}
		</nav>
		<button class='text-slate-600 transition-colors hover:text-blue-600'>
			<span class='material-symbols-outlined'>light_mode</span>
		</button>
	</div>
</header>
