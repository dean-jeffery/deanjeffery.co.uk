---
// src/pages/cv.astro
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title='CV - Dean Jeffery'>
	<Navigation />

	<main>
		<section class='bg-gradient-to-r from-blue-600 to-blue-700 text-white py-20'>
			<div class='max-w-6xl mx-auto px-4 sm:px-6 lg:px-8'>
				<div class='max-w-3xl'>
					<p class='text-sm uppercase tracking-[0.3em] text-blue-100'>Curriculum Vitae</p>
					<h1 class='text-4xl md:text-5xl font-bold mt-4'>Dean Jeffery</h1>
					<p class='text-xl md:text-2xl mt-4 text-blue-100'>Front End Developer</p>
					<p class='mt-6 text-lg text-blue-50'>
						Experienced front end developer with 5+ years building responsive, accessible web experiences and e-commerce solutions.
					</p>
					<div class='mt-8 flex flex-wrap gap-4'>
						<a href='/#contact' class='bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors'>
							Get In Touch
						</a>
						<a
							href='https://www.linkedin.com/in/dean-jeffery'
							target='_blank'
							rel='noopener noreferrer'
							class='border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors'
						>
							View LinkedIn
						</a>
					</div>
				</div>
			</div>
		</section>

		<Experience />
		<Skills />
	</main>

	<Footer />
</Layout>
