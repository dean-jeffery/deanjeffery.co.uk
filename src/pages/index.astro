---
import Layout from '../layouts/Layout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import FocusSection from '../components/landing/FocusSection.astro';
import ServicesSection from '../components/landing/ServicesSection.astro';
import ContactSection from '../components/landing/ContactSection.astro';
import PageFooter from '../components/landing/PageFooter.astro';
import '../styles/global.css';
---

<Layout title='Dean Jeffery | Front-end Developer' description='Dean Jeffery is a Newcastle-based front-end developer building accessible, performant websites.'>
	<div class='min-h-screen bg-slate-50 text-slate-700'>
		<LandingHeader />
		<main class='mx-auto max-w-6xl space-y-24 px-5 py-24 sm:px-6 lg:px-8'>
			<HeroSection />
			<FocusSection />
			<ServicesSection />
			<ContactSection />
		</main>
		<PageFooter />
	</div>
</Layout>
